# ========================================
# FTECA 24 - Environment Variables Template
# ========================================
# Copy this file to `.env` and fill in your actual values
# DO NOT commit `.env` to Git!

# ========================================
# FIREBASE (Required)
# ========================================
# Get from Firebase Console → Project Settings → Service Accounts
# Copy the entire JSON as a single line
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# ========================================
# GITHUB (Required for Data Sync)
# ========================================
# Generate token at: https://github.com/settings/tokens
# Required scope: repo (full control)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repository-name

# ========================================
# ADMIN EMAILS (Required)
# ========================================
# Comma-separated list of admin emails
ADMIN_EMAILS=admin@example.com,admin2@example.com

# ========================================
# AI GATEWAY (Required for AI features)
# ========================================
# Toàn bộ model AI đi qua FTECA AI Gateway.
# Key nhà cung cấp (Groq/Gemini/OpenRouter/...) nằm trong gateway, KHÔNG đặt ở đây.
AI_GATEWAY_URL=https://your-gateway-domain
AI_GATEWAY_KEY=gw_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alias model dùng cho tóm tắt tài liệu (tùy chọn)
# GATEWAY_SUMMARY_ALIAS=gemini-3.5-flash-lite

# ========================================
# OPTIONAL SETTINGS
# ========================================
# Headroom Proxy URL (for context compression)
HEADROOM_PROXY_URL=http://localhost:8787

# Vercel URL (dùng cho metadata)
VERCEL_URL=https://your-app.vercel.app

# ========================================
# OPTIONAL SETTINGS
# ========================================
# Headroom Proxy URL (for context compression)
HEADROOM_PROXY_URL=http://localhost:8787

# Vercel URL (for OpenRouter HTTP-Referer)
VERCEL_URL=https://your-app.vercel.app
