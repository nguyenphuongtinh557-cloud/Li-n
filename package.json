{
  "name": "fteca-24",
  "version": "1.0.0",
  "description": "Hệ thống ôn thi và học tập Ngành Công nghệ Thực phẩm với AI",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "prestart": "npm run build",
    "dev": "node server.js",
    "predev": "npm run build",
    "build": "esbuild modules/themeMorphIcon.js modules/summaryDocx.js --bundle --format=esm --minify --legal-comments=inline --outdir=vendor",
    "test": "playwright test",
    "test:mobile": "node test-mobile.js",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:lumi-study": "node test_lumi_study_assistant.js",
    "test:summary-markdown": "node test_summary_markdown.js",
    "test:summary-explanation-ui": "node test_summary_explanation_ui.js",
    "test:summary-rich-editor": "node test_summary_rich_text_editor.js",
    "test:summary-document-history": "node --test test_summary_document_history.js",
    "test:summary-study-drawing": "node test_summary_study_drawing.js",
    "test:subject-canvas": "node test_subject_canvas.js",
    "test:subject-api": "node test_subject_details_api.js"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "headroom-ai": "^0.38.0",
    "page-mascot": "^0.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "docx": "^9.7.2",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "lucide": "^1.48.0",
    "morphicons": "^1.7.1"
  }
}
